# Texas A&M HPRC, ACES. Cluster facts only (config/sites/README.md).

# Lmod/EasyBuild toolchains (GCC/11.3.0), no Chemistry module. singularity
# exists on compute nodes only, not on login nodes: anything that touches the
# image runs in a job (the pipeline's preflight stage, `llb doctor --node`).
LLB_CONTAINER_SETUP=""               # check: on PATH on compute nodes without a module?
LLB_CONTAINER_LOGIN=no
# Compute nodes reach the internet only through the proxy module.
LLB_PROXY_SETUP="module load WebProxy"
# HPRC recommends installing software in $SCRATCH (1 TB, 250k files; $HOME is
# 10 GB). /scratch/group/<PROJECTID> is 5 TB / 500k files, shared by the
# project: the better home for a site several users share.
LLB_SITE_HINT='/scratch/group/<PROJECTID>/llb or $SCRATCH/llb'
# HPRC recommends SINGULARITY_CACHEDIR=$TMPDIR; llb will set it and
# APPTAINER_CACHEDIR from this (phase 3).
LLB_CACHEDIR_HINT='$TMPDIR'
LLB_PARTITION_HINT=""                # check: which partition for CPU-only array jobs
