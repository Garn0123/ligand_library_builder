# University of Michigan ARC, Lighthouse: lab-owned nodes. Cluster facts only
# (config/sites/README.md).

LLB_CONTAINER_SETUP="module load singularity"   # check: module name and version
LLB_SITE_HINT=/nfs/turbo             # check: same Turbo mounts as Great Lakes
# Partitions are per lab; e.g. maom-h200, one node with 192 cores, so
# LLB_ARRAY_PARALLEL beyond ~190 only queues.
LLB_PARTITION_HINT=maom-h200
