# University of Michigan ARC, Great Lakes. Cluster facts only (config/sites/README.md).

# SingularityCE 4.4.1, as a module; `singularity` reads the same SIF Apptainer does.
LLB_CONTAINER_SETUP="module load singularity"
# Turbo (/nfs/turbo/<share>) is shared, backed-up group storage: the site
# directory goes there. /scratch is purged, so runs only.
LLB_SITE_HINT=/nfs/turbo
LLB_SCRATCH_HINT=/scratch            # check: per-account path (/scratch/<account>_root/...)
LLB_PARTITION_HINT=standard
