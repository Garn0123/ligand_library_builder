# ligand_library_builder -- where the software lives on this machine.
#
# Site layout (docs/INSTALL_DESIGN.md): one directory per cluster, never in ~,
# with the checkout inside it. llb finds hpc.env as ../hpc.env from its checkout:
#   $LLB_SITE/ligand_library_builder/     the checkout
#   $LLB_SITE/hpc.env                     this file: cluster settings, shared by the site's users
#   $LLB_SITE/users/$USER.env             per-user keys, read after hpc.env
#   cp config/hpc.env.example ../hpc.env
#
# Per-user keys go in users/$USER.env (same syntax), not here, so one hpc.env
# serves everyone: ZBH_LICENSE, LLB_MAIL, and LLB_ACCOUNT when yours differs.
# Anything set there overrides this file.
#
# Lookup order (common/env.sh llb_load_config); the old places still work:
#   LLB_CONFIG=/path/to/hpc.env     an override; nothing else is tried
#   ../hpc.env                      the site layout
#   config/hpc.env                  inside the checkout (gitignored)
# users/$USER.env is looked for beside whichever hpc.env is used.
#
# Every wrapper and SLURM script reads the config through common/env.sh.
# Nothing else in the repo hard-codes a path to a tool, so this file is the
# only one to edit when moving machines.
#
# Plain bash: KEY=value, no spaces around '='. Empty means "use the default".
#
# Each tool has up to three knobs, applied in this order:
#   <TOOL>_SETUP  shell run BEFORE conda activation. `module purge` belongs here,
#                 because run after activation it resets PATH/LD_LIBRARY_PATH out
#                 from under the env (db2_converter notebook, 4.1).
#   <TOOL>_ENV    conda env to activate: a name, or an absolute prefix path.
#   <TOOL>_EXE    explicit executable, when it is not on PATH inside the env.

# ---- conda -------------------------------------------------------------------
# Resolved BEFORE any setup hook runs, so a `module purge` cannot hide it.
# Empty = `conda info --base`. Great Lakes: /nfs/turbo/umms-maom/johnbick/miniforge3
CONDA_BASE=

# ---- the toolchain image (container/README.md) --------------------------------
# Set, every tool whose <TOOL>_ENV is EMPTY runs inside this image (apptainer or
# singularity exec ... micromamba run -n ENV); a non-empty <TOOL>_ENV keeps that
# one tool native. Empty = everything native, as before. With LLB_IMAGE set, empty
# QUPKAKE_ENV, DB2C_ENV and PKA_ENV below (and PREP_ENV), or they stay native. In the image the
# <TOOL>_SETUP hooks, CONDA_BASE, XTBPATH and MOLGPKA_DIR are not needed.
#   LLB_IMAGE=$LLB_SITE/llb-toolchain_2026.10.1.sif
LLB_IMAGE=
# Runtime: empty = apptainer, else singularity, whichever is on PATH after
# LLB_CONTAINER_SETUP (Great Lakes: "module load singularity").
LLB_CONTAINER=
LLB_CONTAINER_SETUP=""
# Bound automatically: the checkout, LLB_SITE, the run directory, ZINC_DATA,
# node scratch, ZBH_DIR, ZBH_LICENSE. Anything else, comma-separated (src[:dst]).
LLB_BINDS=

# ---- SLURM -------------------------------------------------------------------
LLB_ACCOUNT=maom99
LLB_PARTITION=standard
# Max simultaneously running array tasks (sbatch --array=...%N), per array.
# QupKake tasks are 1 CPU each, so this is roughly the cores in use: raise it
# (e.g. 200) for a big library if the partition allows.
LLB_ARRAY_PARALLEL=50

# llb pipeline: mail on a stop (a control job exits non-zero) and when a run
# finishes. Empty = no mail. Per-user: set it in users/$USER.env.
LLB_MAIL=

# ---- QupKake (protomer prediction) ------------------------------------------
QUPKAKE_SETUP=""
QUPKAKE_ENV=qupkake
# Empty = `qupkake` on PATH inside QUPKAKE_ENV.
QUPKAKE_EXE=
# xtb 6.4.1 built from source, as QupKake's README recommends. Empty = QupKake's
# bundled Linux binary. Exported as XTBPATH when set.
XTBPATH=

# ---- db2_converter (conformers -> db2; pinned 63d6656) -----------------------
# run_qupkake/slurm/db2_array.sbatch's environment. On Great Lakes:
#   DB2C_SETUP="source ~/env/bcl.sh"
# bcl.sh itself runs `module purge` and loads Chemistry, gcc/8.2.0 (libgfortran
# for AMSOL) and singularity (conformator/UNICON wrappers) -- which is why it
# must run before activation, and why it is a setup hook and not a module line.
# It also exports BCL_ROOT and puts $BCL_ROOT/bin on PATH: the default method,
# conformator_bcl (since 2026-10-20), needs BCL::Conf, and submit-db2 refuses to
# start if db2_converter cannot find it (run_qupkake/check_bcl.py).
DB2C_SETUP=""
DB2C_ENV=db2_converter
# Empty = `build_ligand` on PATH inside DB2C_ENV.
BUILD_LIGAND_EXE=
# db2_converter checkout, only if the package is not importable from DB2C_ENV
# (check_db2_stereo.py imports its enumeration function).
DB2C_SRC=

# ---- ZBH: UNICON + conformator (db2_converter needs both) ----------------------
# Directory holding the unicon and conformator binaries, e.g. $LLB_SITE/zbh.
# Empty = both on PATH after DB2C_SETUP, as before. Set, build_ligand runs them
# through LLB's shims (container/shims/), which add ZBH_LICENSE.
ZBH_DIR=
# Your ZBH licenses (per-user, renewed yearly: set it in users/$USER.env). ZBH
# keeps them in a DIRECTORY, ~/ZBH, one INI-style file per tool ([license] then
# unicon=<key> or conformator=<key>); ZBH_LICENSE is a directory playing that
# role: copy your ~/ZBH there. Empty = $LLB_SITE/licenses/$USER/ZBH in the site
# layout; a checkout outside one can set ZBH_LICENSE=$HOME/ZBH. `llb doctor`
# checks both keys are there (never prints them). The shims run unicon and
# conformator with HOME pointing at a temp dir whose ZBH is this directory; they
# are used in the image and natively when ZBH_DIR is set (else ZBH reads ~/ZBH).
ZBH_LICENSE=

# ---- DOCK6 / db2tool (dock6_claude, pinned 294d235) ---------------------------
# Only for run_qupkake/db2_to_mol2.py (mol2 from the db2). A compiled binary, so
# no conda env: DOCK_SETUP loads whatever it was built against (module load ...).
DOCK_SETUP=""
DOCK_ENV=
# Empty = `db2tool` on PATH after DOCK_SETUP.
DB2TOOL_EXE=

# ---- pKa triage (pka_triage/, branch feat/pka-triage) -------------------------
# MolGpKa on CPU in its own env: create it from environments/llb_pka.yml. MOLGPKA_DIR is
# a clone of github.com/Xundrug/MolGpKa at 4dc8352 (weights + SMARTS are read
# from there; molgpka.py checks the weight files' sha256).
PKA_SETUP=""
PKA_ENV=llb_pka
MOLGPKA_DIR=

# ---- RDKit steps (prepare_parents, assign_names) ------------------------------
# Any env with RDKit; empty = reuse the QupKake env and its setup.
PREP_SETUP=""
PREP_ENV=

# ---- DRAP checkout (llb validate-names; optional) -------------------------------
# llb validate-names runs run_qupkake/validate_names.py, a copy of DRAP's
# stage4/validate_names.py. Set DRAP_DIR to a DRAP checkout to run DRAP's own
# instead (to check against a newer DRAP; tests/test_validate_names_copy.py
# then compares the two).
#   DRAP_DIR=/nfs/turbo/umms-maom/johnbick/opt/drap
DRAP_DIR=

# ---- download (mol_download/) --------------------------------------------------
# Where the ~1 TB of 2D SMILES goes (scratch, not home). run.sh mirrors the URL
# path under it: $ZINC_DATA/zinc22/2d/H17/H17M100.smi.gz
ZINC_DATA=
WGET=wget
PARALLEL=parallel
