# small_molecule_prep -- where the software lives on this machine.
#
#   cp config/hpc.env.example config/hpc.env      # hpc.env is gitignored
#
# Every wrapper and SLURM script reads config/hpc.env through common/env.sh
# (override the location with SMP_CONFIG=/path/to/file). Nothing else in the
# repo hard-codes a path to a tool, so this file is the only one to edit when
# moving machines.
#
# Plain bash: KEY=value, no spaces around '='. Empty means "use the default".
#
# Each tool has up to three knobs, applied in this order:
#   <TOOL>_SETUP  shell run BEFORE conda activation. `module purge` belongs here,
#                 because run after activation it resets PATH/LD_LIBRARY_PATH out
#                 from under the env (db2_converter notebook, 4.1).
#   <TOOL>_ENV    conda env to activate: a name, or an absolute prefix path.
#   <TOOL>_EXE    explicit executable, when it is not on PATH inside the env.

# ---- conda -------------------------------------------------------------------
# Resolved BEFORE any setup hook runs, so a `module purge` cannot hide it.
# Empty = `conda info --base`.
CONDA_BASE=

# ---- SLURM -------------------------------------------------------------------
SMP_ACCOUNT=maom99
SMP_PARTITION=standard
# Max simultaneously running array tasks (sbatch --array=...%N).
SMP_ARRAY_PARALLEL=50

# ---- QupKake (protomer prediction) ------------------------------------------
QUPKAKE_SETUP=""
QUPKAKE_ENV=qupkake
# Empty = `qupkake` on PATH inside QUPKAKE_ENV.
QUPKAKE_EXE=
# xtb 6.4.1 built from source, as QupKake's README recommends. Empty = QupKake's
# bundled Linux binary. Exported as XTBPATH when set.
XTBPATH=

# ---- db2_converter (conformers -> db2; pinned 63d6656) -----------------------
# Your db2_array.sbatch environment, e.g.
#   DB2C_SETUP="module purge; module load Chemistry gcc/8.2.0 singularity; source ~/env/bcl.sh"
DB2C_SETUP=""
DB2C_ENV=db2_converter
# Empty = `build_ligand` on PATH inside DB2C_ENV.
BUILD_LIGAND_EXE=
# db2_converter checkout, only if the package is not importable from DB2C_ENV
# (check_db2_stereo.py imports its enumeration function).
DB2C_SRC=

# ---- RDKit steps (prepare_parents, assign_names) ------------------------------
# Any env with RDKit; empty = reuse the QupKake env and its setup.
PREP_SETUP=""
PREP_ENV=

# ---- download (mol_download/) --------------------------------------------------
# Where the ~1 TB of 2D SMILES goes (scratch, not home). run.sh mirrors the URL
# path under it: $ZINC_DATA/zinc22/2d/H17/H17M100.smi.gz
ZINC_DATA=
WGET=wget
PARALLEL=parallel
