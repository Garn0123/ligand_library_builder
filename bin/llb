#!/bin/bash
# llb -- run any ligand_library_builder step from any directory.
#
# Keep the code in one place (e.g. /nfs/turbo/umms-maom/johnbick/opt/ligand_library_builder)
# and put this on PATH; every step then reads and writes relative to your
# CURRENT directory, so each run lives in its own run directory and the code
# checkout is never written to:
#
#   export PATH=/path/to/opt/ligand_library_builder/bin:$PATH     # e.g. in ~/.bashrc
#   export LLB_CONFIG=$HOME/.config/llb/hpc.env                    # optional; default
#                                       #   <repo>/../hpc.env (site layout), else <repo>/config/hpc.env
#   mkdir -p /scratch/.../my_run && cd /scratch/.../my_run
#   llb sample --heavy 18-22 --total 50000 --local $ZINC_DATA/zinc22 --outdir samples
#
# Steps that need one run inside the environment hpc.env names for it (PREP or
# DOCK; common/env.sh says where hpc.env is looked for).
#
# ZINC download and sampling (ZINC SMILES -> samples/Hxx.smi):
#   llb print-urls ARGS       mol_download/sample_2d.py --print-urls     (no env)
#   llb extract-urls FILE...  mol_download/extract_urls.sh               (no env)
#   llb fetch LIST [J]        mol_download/run.sh  (files land under $PWD)
#   llb fetch-verify [--purge]  /  llb fetch-status LIST
#   llb tranche-pattern [permanent.tsv]  are the 404s real absences?   (no env)
#   llb sample ARGS           mol_download/sample_2d.py  (--local, --per-bin, --total)  (no env)
#
# ZINC22's own 3D db2s for a set of ZINC ids (mol_download/zinc3d/RUNBOOK.md):
#   llb zinc3d-catalog ARGS   list every chunk + size on files.docking.org   (PREP)
#   llb zinc3d-plan ARGS      ids -> id lists to fetch + cost estimate       (PREP)
#   llb zinc3d-index groups|chunks ARGS  ids -> exact chunks, via sidecars   (PREP)
#   llb zinc3d-fetch LIST [J] one SLURM job: run.sh + retry passes (logs -> ./logs)
#   llb zinc3d-extract PLAN OUT [opts]   SLURM array: wanted records -> db2.gz
#   llb zinc3d-collect ARGS   merge records/ after the array; check nothing lost (PREP)
#
# Ligand construction (SMILES -> db2) is MolSanitizer's (molsanitizer/), in two passes
# with the naming step between them (UPSTREAM.md section 2):
#   llb names --inputs SMI... --ms CLEAN_SMI... -o library
#                             MolSanitizer's NAME_state.stereo -> 16-character contract
#                             names, library.smi + library.tsv, naming/assign_names.py (PREP)
#
# Docking jobs and after (docking/README.md):
#   llb chunk RUNDIR DB2DIR [opts]  mol_compiler/parallel/submit_chunks.sh  (no env)
#   llb mol2 ARGS             docking/db2_to_mol2.py  (mol2 from the db2)    (DOCK)
#   llb mol2-library MOL2 --library TSV -o DIR [--shard-size N]
#                             DOCK-header multi-mol2 shards, docking/mol2_library.py (PREP)
#   llb collapse-invertomers SCORES --library library.tsv -o OUT
#                             best score per N-H+ invertomer group, docking/collapse_invertomers.py (PREP)
#
# Utilities:
#   llb env TOOL CMD...       run CMD in TOOL's env (PREP, DOCK)
#   llb root                  print the code checkout this llb belongs to
#   llb help                  this text

set -euo pipefail

# Resolve symlinks so a link to bin/llb (e.g. from ~/bin) still finds the repo.
src="${BASH_SOURCE[0]}"
while [[ -L "$src" ]]; do
    dir="$(cd "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"; [[ "$src" == /* ]] || src="$dir/$src"
done
LLB_ROOT="$(cd "$(dirname "$src")/.." && pwd)"
export LLB_ROOT

usage() { sed -n '2,/^$/p' "$LLB_ROOT/bin/llb" | sed 's/^# \{0,1\}//'; }

step="${1:-help}"; [[ $# -gt 0 ]] && shift
W="$LLB_ROOT/common/with_env.sh"
K="$LLB_ROOT/docking"
D="$LLB_ROOT/mol_download"

case "$step" in
    print-urls)     exec python3 "$D/sample_2d.py" --print-urls "$@" ;;
    extract-urls)   exec "$D/extract_urls.sh" "$@" ;;
    fetch)          exec "$D/run.sh" "$@" ;;
    fetch-verify)   exec "$D/verify.sh" "$@" ;;
    fetch-status)   exec "$D/status.sh" "$@" ;;
    tranche-pattern) exec "$D/tranche_pattern.sh" "$@" ;;
    sample)         exec python3 "$D/sample_2d.py" "$@" ;;
    zinc3d-catalog) exec "$W" PREP python "$D/zinc3d/catalog.py" "$@" ;;
    zinc3d-plan)    exec "$W" PREP python "$D/zinc3d/plan.py" "$@" ;;
    zinc3d-index)   exec "$W" PREP python "$D/zinc3d/index.py" "$@" ;;
    zinc3d-fetch)   exec "$D/zinc3d/submit_fetch.sh" "$@" ;;
    zinc3d-extract) exec "$D/zinc3d/submit_extract.sh" "$@" ;;
    zinc3d-collect) exec "$W" PREP python "$D/zinc3d/extract.py" --collect "$@" ;;
    names)          exec "$W" PREP python "$LLB_ROOT/naming/assign_names.py" "$@" ;;
    chunk)          exec "$LLB_ROOT/mol_compiler/parallel/submit_chunks.sh" "$@" ;;
    mol2)           exec "$W" DOCK python3 "$K/db2_to_mol2.py" "$@" ;;
    mol2-library)   exec "$W" PREP python "$K/mol2_library.py" "$@" ;;
    collapse-invertomers) exec "$W" PREP python "$K/collapse_invertomers.py" "$@" ;;
    env)            exec "$W" "$@" ;;
    root)           echo "$LLB_ROOT" ;;
    help|-h|--help) usage ;;
    *) echo "llb: unknown step '$step'" >&2; usage >&2; exit 64 ;;
esac
