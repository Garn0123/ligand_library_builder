#!/bin/bash
# unicon / conformator (symlinks to this file) -- run the user's ZBH binary with
# the user's license, wherever both live.
#
# The binary: $ZBH_DIR/<tool>, else the next <tool> on PATH after this directory.
# The license: ZBH reads licenses only from ~/ZBH, so with ZBH_LICENSE set (a
# directory standing in for ~/ZBH) the tool runs with HOME pointing at a private
# temp dir whose ZBH is a link to it. Nothing in the real ~ is needed or touched.
set -uo pipefail
tool="$(basename "$0")"
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exe=""
if [[ -n "${ZBH_DIR:-}" ]]; then
    exe="$ZBH_DIR/$tool"
else
    IFS=: read -ra dirs <<<"${PATH:-}"
    for d in "${dirs[@]}"; do
        [[ "$(cd "$d" 2>/dev/null && pwd)" == "$here" ]] && continue
        [[ -x "$d/$tool" ]] && { exe="$d/$tool"; break; }
    done
fi
[[ -n "$exe" && -x "$exe" ]] || {
    echo "$tool: no ZBH binary (ZBH_DIR='${ZBH_DIR:-}'); set ZBH_DIR in hpc.env, then llb doctor --stage db2" >&2
    exit 127; }
[[ -n "${ZBH_LICENSE:-}" ]] || exec "$exe" "$@"
home="$(mktemp -d "${TMPDIR:-/tmp}/llb-zbh.XXXXXX")" || exit 1
trap 'rm -rf "$home"' EXIT
ln -s "$ZBH_LICENSE" "$home/ZBH"
HOME="$home" "$exe" "$@"
