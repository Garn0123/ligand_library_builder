# llb.def -- the LLB toolchain image (docs/INSTALL_DESIGN.md, "The toolchain image").
#
# Build from the REPOSITORY ROOT (the %files paths are relative to it):
#   oras pull ghcr.io/garn0123/llb-assets:bcl-4.3.1 -o container/assets
#   apptainer build --fakeroot llb.sif container/llb.def
# (container/README.md). Works with Apptainer >= 1.3 and SingularityCE >= 4.4,
# and uses only %files, %post, %environment, %labels and %help.
#
# Everything pinned here is also written to /opt/llb/manifest.json:
#   base image      digest below
#   conda envs      environments/*.linux-64.lock (sha256 of each in the manifest)
#   micromamba      release + sha256
#   xtb 6.4.1       release source tarball + sha256, built here
#   QupKake         commit, via the qupkake lockfile's pip line
#   db2_converter   commit, cloned and checked
#   MolGpKa         commit, cloned and checked, plus the weights' sha256
#   BCL 4.3.1       static tarball from GHCR (ORAS) + sha256 (BCL_SHA256 below)
# Not in the image: LLB's own code (bind-mounted at run time), UNICON and
# conformator (ZBH, licensed per user), DOCK/db2tool.

Bootstrap: docker
# ubuntu:22.04, multi-arch index digest as of 2026-10-17 (Docker Hub). To move it:
#   docker buildx imagetools inspect ubuntu:22.04   (or the registry API) -> new digest
From: ubuntu@sha256:0a9887931b0e38af2e3487ed39e29436b0535c4f3f52e57745baaf79d1898956

# %files: container/assets/ holds the BCL tarball (oras pull) and/or CI's empty
# marker ALLOW_MISSING_BCL; %post consumes and deletes it. The directory always
# exists (it is committed with only a .gitignore), so %files never fails on it.

%files
    container/TOOLCHAIN_VERSION /opt/llb/TOOLCHAIN_VERSION
    container/NOTICE /opt/llb/NOTICE
    container/licenses /opt/llb/licenses
    container/smoke.sh /opt/llb/smoke.sh
    environments /opt/llb/environments
    container/assets /opt/llb-assets

%post -c /bin/bash
    set -euo pipefail

    # ---------------------------------------------------------------- pins
    UBUNTU_DIGEST=sha256:0a9887931b0e38af2e3487ed39e29436b0535c4f3f52e57745baaf79d1898956
    MICROMAMBA_VERSION=2.8.1-0
    MICROMAMBA_SHA256=9689782d863c05a1bf5d2d371ba527104e7a4eb4310c1637d8653b751aed9c82
    XTB_VERSION=6.4.1
    XTB_SHA256=15cfd8743dd963c54e0fee12da5ee34a08dde78625cf8a0a21eee1eaa652beae
    QUPKAKE_COMMIT=f7a294e91929e4e4f0a7100ad5cf5a64a34a7d4f
    DB2C_COMMIT=63d6656f4b39a18b08488758bf9875d44f401c03
    MOLGPKA_COMMIT=4dc835219baad18c2e705274ac54d49597703966
    BCL_VERSION=4.3.1
    BCL_TARBALL=bcl-4.3.1-static-linux-x86_64.tar.xz
    BCL_ORAS_REF=ghcr.io/garn0123/llb-assets:bcl-4.3.1
    # sha256 of $BCL_TARBALL. TODO until John publishes the tarball
    # (container/bcl/BUILD.md); while it is TODO every build fails here unless
    # the build context holds container/assets/ALLOW_MISSING_BCL (CI on push).
    BCL_SHA256=TODO

    TOOLCHAIN_VERSION=$(tr -d '[:space:]' < /opt/llb/TOOLCHAIN_VERSION)
    [[ "$TOOLCHAIN_VERSION" =~ ^[0-9]{4}\.[0-9]{2}\.[0-9]+$ ]] \
        || { echo "FATAL: container/TOOLCHAIN_VERSION '$TOOLCHAIN_VERSION' is not YYYY.MM.N" >&2; exit 1; }
    BUILD_DATE=$(date -u +%Y-%m-%dT%H:%M:%SZ)

    export DEBIAN_FRONTEND=noninteractive LC_ALL=C.UTF-8 LANG=C.UTF-8
    export MAMBA_ROOT_PREFIX=/opt/conda
    export XTBPATH=/opt/xtb/bin/xtb BCL_ROOT=/opt/bcl MOLGPKA_DIR=/opt/MolGpKa
    export PYTHONNOUSERSITE=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1

    # ---------------------------------------------------------------- BCL decision first
    # (so a build that is going to refuse does so in seconds, not after an hour)
    ALLOW_MISSING_BCL=0
    [[ -e /opt/llb-assets/ALLOW_MISSING_BCL ]] && ALLOW_MISSING_BCL=1
    BCL_INSTALL=0
    BCL_SKIP_REASON=""
    if [[ "$BCL_SHA256" == TODO ]]; then
        BCL_SKIP_REASON="BCL_SHA256 is TODO in container/llb.def"
    elif [[ ! -f /opt/llb-assets/$BCL_TARBALL ]]; then
        BCL_SKIP_REASON="container/assets/$BCL_TARBALL not in the build context (oras pull $BCL_ORAS_REF -o container/assets)"
    else
        BCL_INSTALL=1
    fi
    if [[ $BCL_INSTALL -eq 0 ]]; then
        if [[ $ALLOW_MISSING_BCL -eq 1 ]]; then
            for _ in 1 2 3; do
                echo "################################################################" >&2
            done
            echo "WARNING: building WITHOUT BCL: $BCL_SKIP_REASON." >&2
            echo "WARNING: ALLOW_MISSING_BCL is set. This image cannot run -m conformator_bcl" >&2
            echo "WARNING: and must not be released; manifest.json records bcl.installed=false." >&2
            echo "################################################################" >&2
        else
            echo "FATAL: $BCL_SKIP_REASON." >&2
            echo "FATAL: an image without BCL is only built on purpose: put an empty file" >&2
            echo "FATAL: container/assets/ALLOW_MISSING_BCL in the build context (CI's allow_missing_bcl)." >&2
            exit 1
        fi
    fi

    # ---------------------------------------------------------------- system packages
    # runtime: libgfortran5 (AMSOL and xtb link it), libgomp1, OpenBLAS (xtb), git
    # (pip installs QupKake from git; LLB records its own commit from inside)
    RUNTIME_PKGS="ca-certificates git libgfortran5 libgomp1 libopenblas0-openmp procps xz-utils bzip2"
    BUILD_PKGS="curl build-essential gfortran cmake libopenblas-openmp-dev"
    apt-get update -q
    apt-get install -y -q --no-install-recommends $RUNTIME_PKGS $BUILD_PKGS
    apt-mark manual $RUNTIME_PKGS >/dev/null

    # ---------------------------------------------------------------- micromamba + conda stub
    curl -fsSL -o /usr/local/bin/micromamba \
        "https://github.com/mamba-org/micromamba-releases/releases/download/${MICROMAMBA_VERSION}/micromamba-linux-64"
    echo "${MICROMAMBA_SHA256}  /usr/local/bin/micromamba" | sha256sum -c -
    chmod 755 /usr/local/bin/micromamba
    mkdir -p "$MAMBA_ROOT_PREFIX/envs"

    # QupKake runs `conda list xtb` at import and dies with FileNotFoundError when
    # there is no conda. micromamba's answer lists no xtb (none is in the env), so
    # QupKake's assert fails and it takes $XTBPATH, the xtb built below.
    cat > /usr/local/bin/conda <<'EOF'
#!/bin/sh
# conda -> micromamba, for QupKake's import-time `conda list xtb` (container/llb.def).
# Not a conda: only `list` is meant to be used through it.
exec /usr/local/bin/micromamba "$@"
EOF
    chmod 755 /usr/local/bin/conda

    # ---------------------------------------------------------------- the three envs
    # conda part with micromamba (md5-checked), pip part with pip --no-deps
    # (sha256-checked URL fragments; conda-lock already resolved them).
    for env in qupkake db2_converter llb_pka; do
        lock=/opt/llb/environments/$env.linux-64.lock
        grep -v '^# pip ' "$lock" > /tmp/$env.conda.txt
        micromamba create -y -q -p "$MAMBA_ROOT_PREFIX/envs/$env" -f /tmp/$env.conda.txt
        grep '^# pip ' "$lock" | sed 's/^# pip //' > /tmp/$env.pip.txt || true
        if [[ -s /tmp/$env.pip.txt ]]; then
            "$MAMBA_ROOT_PREFIX/envs/$env/bin/python" -m pip install -q --no-deps -r /tmp/$env.pip.txt
        fi
        rm -f /tmp/$env.conda.txt /tmp/$env.pip.txt
    done
    grep -q "qupkake @ git+https://github.com/Shualdon/QupKake@${QUPKAKE_COMMIT}" \
        /opt/llb/environments/qupkake.linux-64.lock \
        || { echo "FATAL: qupkake lockfile does not pin QupKake ${QUPKAKE_COMMIT}" >&2; exit 1; }

    # ---------------------------------------------------------------- db2_converter (clone, editable)
    # Its setup.py has no package_data, so only an editable install keeps
    # amsol/amsol7.1_patched and the data files next to config.py.
    git clone -q https://github.com/hnlab/db2_converter /opt/db2_converter
    git -C /opt/db2_converter checkout -q "$DB2C_COMMIT"
    [[ "$(git -C /opt/db2_converter rev-parse HEAD)" == "$DB2C_COMMIT" ]]
    rm -rf /opt/db2_converter/.git
    "$MAMBA_ROOT_PREFIX/envs/db2_converter/bin/python" -m pip install -q --no-deps --no-build-isolation -e /opt/db2_converter
    DB2C_CONFIG=/opt/db2_converter/db2_converter/config.py
    # Point BCL at /opt/bcl, the edit db2_converter's README asks for. BCLBASE is
    # the bin/ directory: db2_converter prepends BCLBASE to PATH *and*
    # LD_LIBRARY_PATH for the BCL call, and bin/ holds no libraries. BCL is a bare
    # command name resolved through that PATH (run_qupkake/check_bcl.py treats an
    # absolute value as a path that must exist, and this one carries arguments).
    # UNICON_EXE / CONF_EXE stay bare names: LLB's shims are on PATH at run time.
    sed -i -E \
        -e 's|("BCLBASE": *f?")[^"]*"|\1/opt/bcl/bin"|' \
        -e 's|("BCL": *f?")[^"]*"|\1bcl-apps-static.exe molecule:ConformerGenerator"|' \
        "$DB2C_CONFIG"
    grep -q '"BCLBASE": f"/opt/bcl/bin"' "$DB2C_CONFIG" \
        && grep -q '"BCL": f"bcl-apps-static.exe molecule:ConformerGenerator"' "$DB2C_CONFIG" \
        || { echo "FATAL: the BCL sed did not apply to $DB2C_CONFIG" >&2; grep -n BCL "$DB2C_CONFIG" >&2; exit 1; }
    grep -q '"UNICON_EXE": f"unicon"' "$DB2C_CONFIG" && grep -q '"CONF_EXE": f"conformator"' "$DB2C_CONFIG"
    AMSOL=/opt/db2_converter/db2_converter/amsol/amsol7.1_patched
    chmod 755 "$AMSOL"

    # ---------------------------------------------------------------- xtb 6.4.1 from source
    cd /tmp
    curl -fsSL -o xtb.tar.xz \
        "https://github.com/grimme-lab/xtb/releases/download/v${XTB_VERSION}/xtb-${XTB_VERSION}.tar.xz"
    echo "${XTB_SHA256}  xtb.tar.xz" | sha256sum -c -
    tar -xJf xtb.tar.xz
    cmake -S "xtb-${XTB_VERSION}" -B xtb-build -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/opt/xtb -DCMAKE_INSTALL_LIBDIR=lib
    cmake --build xtb-build -j "$(nproc)"
    cmake --install xtb-build
    rm -rf /tmp/xtb.tar.xz "/tmp/xtb-${XTB_VERSION}" /tmp/xtb-build
    xtb_out=$("$XTBPATH" --version 2>&1 || true)
    grep -q "xtb version ${XTB_VERSION}" <<<"$xtb_out" \
        || { echo "FATAL: $XTBPATH --version is not ${XTB_VERSION}:" >&2; echo "$xtb_out" >&2; exit 1; }

    # ---------------------------------------------------------------- MolGpKa
    git clone -q https://github.com/Xundrug/MolGpKa "$MOLGPKA_DIR"
    git -C "$MOLGPKA_DIR" checkout -q "$MOLGPKA_COMMIT"
    [[ "$(git -C "$MOLGPKA_DIR" rev-parse HEAD)" == "$MOLGPKA_COMMIT" ]]
    rm -rf "$MOLGPKA_DIR/.git"

    # ---------------------------------------------------------------- BCL
    if [[ $BCL_INSTALL -eq 1 ]]; then
        echo "${BCL_SHA256}  /opt/llb-assets/${BCL_TARBALL}" | sha256sum -c -
        mkdir -p /tmp/bcl-unpack
        tar -xJf "/opt/llb-assets/${BCL_TARBALL}" -C /tmp/bcl-unpack --no-same-owner
        rm -f "/opt/llb-assets/${BCL_TARBALL}"
        # one top-level directory (container/bcl/BUILD.md); move its contents to /opt/bcl
        top=$(find /tmp/bcl-unpack -mindepth 1 -maxdepth 1)
        [[ $(wc -l <<<"$top") -eq 1 && -d "$top" ]] \
            || { echo "FATAL: $BCL_TARBALL must hold exactly one top-level directory (BUILD.md)" >&2; exit 1; }
        mv "$top" /opt/bcl
        rmdir /tmp/bcl-unpack
        BCL_EXE=/opt/bcl/bin/bcl-apps-static.exe
        [[ -x $BCL_EXE ]] || { echo "FATAL: $BCL_EXE missing from the tarball (BUILD.md layout)" >&2; exit 1; }
        bcl_ldd=$(ldd "$BCL_EXE" 2>&1 || true)     # "not a dynamic executable" when static
        if grep -q 'not found' <<<"$bcl_ldd"; then
            echo "FATAL: $BCL_EXE needs libraries the image lacks:" >&2; echo "$bcl_ldd" >&2; exit 1
        fi
        if [[ -n "$(find /opt/bcl/bin -maxdepth 1 -name '*.so*')" ]]; then
            echo "FATAL: /opt/bcl/bin holds shared libraries; db2_converter puts BCLBASE on LD_LIBRARY_PATH" >&2
            exit 1
        fi
    fi
    rm -rf /opt/llb-assets

    # ---------------------------------------------------------------- manifest + labels
    lock_sha() { sha256sum "/opt/llb/environments/$1.linux-64.lock" | cut -d' ' -f1; }
    BCL_INSTALLED=$([[ $BCL_INSTALL -eq 1 ]] && echo true || echo false)
    cat > /opt/llb/manifest.json <<EOF
{
  "toolchain_version": "${TOOLCHAIN_VERSION}",
  "build_date": "${BUILD_DATE}",
  "base_image": {"name": "ubuntu:22.04", "digest": "${UBUNTU_DIGEST}"},
  "micromamba": {"version": "${MICROMAMBA_VERSION}", "sha256": "${MICROMAMBA_SHA256}"},
  "lockfiles": {
    "qupkake": {"path": "environments/qupkake.linux-64.lock", "sha256": "$(lock_sha qupkake)"},
    "db2_converter": {"path": "environments/db2_converter.linux-64.lock", "sha256": "$(lock_sha db2_converter)"},
    "llb_pka": {"path": "environments/llb_pka.linux-64.lock", "sha256": "$(lock_sha llb_pka)"}
  },
  "xtb": {"version": "${XTB_VERSION}", "source_sha256": "${XTB_SHA256}", "path": "/opt/xtb/bin/xtb"},
  "qupkake": {"commit": "${QUPKAKE_COMMIT}", "env": "/opt/conda/envs/qupkake"},
  "db2_converter": {"commit": "${DB2C_COMMIT}", "path": "/opt/db2_converter",
                    "config_edits": {"bcl.BCLBASE": "/opt/bcl/bin", "bcl.BCL": "bcl-apps-static.exe molecule:ConformerGenerator"}},
  "molgpka": {"commit": "${MOLGPKA_COMMIT}", "path": "${MOLGPKA_DIR}"},
  "bcl": {"version": "${BCL_VERSION}", "installed": ${BCL_INSTALLED}, "sha256": "${BCL_SHA256}",
          "source": "oras://${BCL_ORAS_REF}", "tarball": "${BCL_TARBALL}", "skip_reason": "${BCL_SKIP_REASON}"}
}
EOF
    "$MAMBA_ROOT_PREFIX/envs/llb_pka/bin/python" -c 'import json; json.load(open("/opt/llb/manifest.json"))'
    LABELS=${APPTAINER_LABELS:-${SINGULARITY_LABELS:-}}
    if [[ -n "$LABELS" ]]; then
        {
            echo "org.llb.toolchain.version ${TOOLCHAIN_VERSION}"
            echo "org.opencontainers.image.version ${TOOLCHAIN_VERSION}"
            echo "org.opencontainers.image.created ${BUILD_DATE}"
            echo "org.llb.bcl.installed ${BCL_INSTALLED}"
        } >> "$LABELS"
    fi

    # ---------------------------------------------------------------- slim down, then test
    apt-get purge -y -q $BUILD_PKGS
    apt-get autoremove -y -q --purge
    apt-get clean
    rm -rf /var/lib/apt/lists/* /tmp/* /root/.cache
    micromamba clean -a -y -q
    chmod -R a+rX /opt

    SMOKE_ARGS=()
    [[ $BCL_INSTALL -eq 0 ]] && SMOKE_ARGS=(--allow-missing-bcl)
    chmod 755 /opt/llb/smoke.sh
    /opt/llb/smoke.sh "${SMOKE_ARGS[@]}"

%environment
    export LC_ALL=C.UTF-8 LANG=C.UTF-8
    export MAMBA_ROOT_PREFIX=/opt/conda
    export PATH=/opt/xtb/bin:/opt/bcl/bin:/usr/local/bin:$PATH
    export XTBPATH=/opt/xtb/bin/xtb
    export BCL_ROOT=/opt/bcl
    export MOLGPKA_DIR=/opt/MolGpKa
    export LLB_TOOLCHAIN_VERSION="$(cat /opt/llb/TOOLCHAIN_VERSION 2>/dev/null)"
    export LLB_TOOLCHAIN_MANIFEST=/opt/llb/manifest.json
    # ~/.local site-packages from the host must not leak into the envs
    export PYTHONNOUSERSITE=1
    # BCL's lib/ is deliberately NOT on LD_LIBRARY_PATH: it shadowed the envs'
    # libstdc++/libgomp. The static binary needs none.

%labels
    org.opencontainers.image.title llb-toolchain
    org.opencontainers.image.description Third-party toolchain for ligand_library_builder (QupKake+xtb, db2_converter+AMSOL+BCL, MolGpKa)
    org.opencontainers.image.source https://github.com/Garn0123/ligand_library_builder
    org.opencontainers.image.licenses see /opt/llb/NOTICE

%help
    LLB toolchain image: the third-party tools ligand_library_builder (LLB) runs,
    in three micromamba envs plus /opt. LLB itself is not inside; `llb` bind-mounts
    its checkout and runs each step as
        apptainer exec --bind ... llb.sif micromamba run -n <env> <cmd>

    envs (/opt/conda/envs):  qupkake  db2_converter  llb_pka
    /opt/xtb                 xtb 6.4.1 (XTBPATH=/opt/xtb/bin/xtb)
    /opt/bcl                 BCL 4.3.1 static (BCL_ROOT=/opt/bcl)
    /opt/db2_converter       db2_converter 63d6656, AMSOL 7.1 (DOCK-patched)
    /opt/MolGpKa             MolGpKa 4dc8352 (MOLGPKA_DIR)
    /opt/llb/manifest.json   every pin, lockfile hashes, build date, toolchain version
    /opt/llb/NOTICE          licences (texts in /opt/llb/licenses)

    Check the image:   apptainer exec llb.sif /opt/llb/smoke.sh
    Version:           apptainer inspect --labels llb.sif | grep toolchain
    UNICON and conformator are not included (ZBH licence, per user).
